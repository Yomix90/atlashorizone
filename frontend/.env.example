# ─── Site public ─────────────────────────────────────────
# URL canonique du site (sans slash final) — utilisée pour SEO, hreflang, sitemap
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Strapi ──────────────────────────────────────────────
# URL de l'API vue depuis le serveur Next.js (en Docker : http://strapi:1337)
STRAPI_API_URL=http://localhost:1337
# URL publique des médias (images), vue depuis le navigateur. En prod : https://cms.example-agence.ma
NEXT_PUBLIC_MEDIA_URL=http://localhost:1337
# Même valeur que FRONTEND_API_TOKEN côté Strapi. Serveur uniquement, jamais exposée au navigateur.
STRAPI_API_TOKEN=changeMe_au_moins_32_caracteres_aleatoires____

# Secret partagé avec Strapi pour invalider le cache ISR (même valeur que REVALIDATE_SECRET côté Strapi)
REVALIDATE_SECRET=changeMe_secret_revalidation

# ─── Anti-spam : Cloudflare Turnstile ────────────────────
# Clés de TEST officielles Cloudflare (toujours valides) — à remplacer en production.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# ─── Mesure d'audience (optionnelle, chargée seulement après consentement) ─
NEXT_PUBLIC_GA_ID=

# Autoriser l'optimisation d'images depuis une IP privée (utile si Strapi est sur le même hôte sans domaine)
IMAGES_ALLOW_LOCAL_IP=false

# Domaines d'images supplémentaires (Cloudinary, S3/CDN), séparés par des virgules
EXTRA_IMAGE_HOSTS=
