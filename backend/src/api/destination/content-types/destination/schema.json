{
  "kind": "collectionType",
  "collectionName": "destinations",
  "info": {
    "singularName": "destination",
    "pluralName": "destinations",
    "displayName": "Destination",
    "description": "Destinations et circuits proposés par l’agence"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "region": {
      "type": "enumeration",
      "required": true,
      "enum": [
        "tanger_tetouan_al_hoceima",
        "oriental",
        "fes_meknes",
        "rabat_sale_kenitra",
        "beni_mellal_khenifra",
        "casablanca_settat",
        "marrakech_safi",
        "draa_tafilalet",
        "souss_massa",
        "guelmim_oued_noun",
        "laayoune_sakia_el_hamra",
        "dakhla_oued_ed_dahab"
      ],
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "tripType": {
      "type": "enumeration",
      "required": true,
      "enum": [
        "desert",
        "imperial_city",
        "beach",
        "mountain",
        "culture"
      ],
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "summary": {
      "type": "text",
      "required": true,
      "maxLength": 320,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "description": {
      "type": "blocks",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "highlights": {
      "type": "component",
      "repeatable": true,
      "component": "shared.list-item",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "itinerary": {
      "type": "component",
      "repeatable": true,
      "component": "destination.itinerary-day",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "included": {
      "type": "component",
      "repeatable": true,
      "component": "shared.list-item",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "excluded": {
      "type": "component",
      "repeatable": true,
      "component": "shared.list-item",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "bestPeriod": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "bestMonths": {
      "type": "json",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "difficulty": {
      "type": "enumeration",
      "required": true,
      "enum": [
        "easy",
        "moderate",
        "challenging"
      ],
      "default": "easy",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "durationDays": {
      "type": "integer",
      "required": true,
      "min": 1,
      "default": 1,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "priceAdult": {
      "type": "decimal",
      "required": true,
      "min": 0,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "priceChild": {
      "type": "decimal",
      "min": 0,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "coverImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ],
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "gallery": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images",
        "videos"
      ],
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "latitude": {
      "type": "float",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "longitude": {
      "type": "float",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "featured": {
      "type": "boolean",
      "default": false,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "popularity": {
      "type": "integer",
      "default": 0,
      "min": 0,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "ratingAverage": {
      "type": "decimal",
      "default": 0,
      "min": 0,
      "max": 5,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "ratingCount": {
      "type": "integer",
      "default": 0,
      "min": 0,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "reviews": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::review.review",
      "mappedBy": "destination"
    }
  }
}
