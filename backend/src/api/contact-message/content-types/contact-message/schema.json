{
  "kind": "collectionType",
  "collectionName": "contact_messages",
  "info": {
    "singularName": "contact-message",
    "pluralName": "contact-messages",
    "displayName": "Message de contact",
    "description": "Messages du formulaire de contact et demandes de circuits sur mesure"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "kind": {
      "type": "enumeration",
      "enum": [
        "general",
        "custom_trip"
      ],
      "default": "general",
      "required": true
    },
    "name": {
      "type": "string",
      "required": true,
      "maxLength": 120
    },
    "email": {
      "type": "email",
      "required": true
    },
    "phone": {
      "type": "string",
      "maxLength": 30
    },
    "subject": {
      "type": "string",
      "maxLength": 200
    },
    "message": {
      "type": "text",
      "required": true,
      "maxLength": 5000
    },
    "tripDetails": {
      "type": "json"
    },
    "customerLocale": {
      "type": "enumeration",
      "enum": [
        "fr",
        "en",
        "es",
        "de",
        "ar"
      ],
      "default": "fr"
    },
    "handled": {
      "type": "boolean",
      "default": false
    },
    "internalNotes": {
      "type": "text",
      "private": true
    }
  }
}
