# ─── Serveur ──────────────────────────────────────────────
HOST=0.0.0.0
PORT=1337
# URL publique de Strapi (admin + médias). En prod : https://cms.example-agence.ma
PUBLIC_URL=http://localhost:1337
IS_PROXIED=false
NODE_ENV=development

# ─── Secrets ──────────────────────────────────────────────
# Générer chaque valeur avec :
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_KEYS=changeMe1,changeMe2,changeMe3,changeMe4
API_TOKEN_SALT=changeMe
ADMIN_JWT_SECRET=changeMe
TRANSFER_TOKEN_SALT=changeMe
JWT_SECRET=changeMe
ENCRYPTION_KEY=changeMe

# Jeton d'API partagé avec le serveur Next.js (>= 32 caractères, jamais exposé au navigateur).
# Au démarrage, Strapi crée/met à jour le token « frontend-server » avec cette valeur.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
FRONTEND_API_TOKEN=changeMe_au_moins_32_caracteres_aleatoires____

# ─── Base de données ──────────────────────────────────────
DATABASE_CLIENT=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=strapi
DATABASE_USERNAME=strapi
DATABASE_PASSWORD=strapi
DATABASE_SSL=false
# Essai local sans PostgreSQL : DATABASE_CLIENT=sqlite et DATABASE_FILENAME=.tmp/data.db

# ─── CORS / CSP ───────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:1337
# Domaines supplémentaires autorisés pour les images (Cloudinary, S3…), séparés par des virgules
CSP_MEDIA_SOURCES=

# ─── Front-end (revalidation ISR déclenchée par Strapi) ───
FRONTEND_URL=http://localhost:3000
REVALIDATE_SECRET=changeMe_secret_revalidation

# ─── Emails (Nodemailer SMTP) ─────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM="Atlas Horizons Voyages <no-reply@example-agence.ma>"
EMAIL_REPLY_TO=contact@example-agence.ma

# ─── Stockage des médias : local | cloudinary | aws-s3 ────
UPLOAD_PROVIDER=local
CLOUDINARY_NAME=
CLOUDINARY_KEY=
CLOUDINARY_SECRET=
S3_ACCESS_KEY_ID=
S3_ACCESS_SECRET=
S3_REGION=
S3_BUCKET=
S3_ENDPOINT=
S3_CDN_URL=

# Langue initiale du plugin i18n
STRAPI_PLUGIN_I18N_INIT_LOCALE_CODE=fr
