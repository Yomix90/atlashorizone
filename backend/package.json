{
  "name": "atlas-horizons-backend",
  "private": true,
  "version": "1.0.0",
  "description": "CMS headless Strapi 5 de l'agence (destinations, réservations, contacts, avis)",
  "scripts": {
    "develop": "strapi develop",
    "dev": "strapi develop",
    "start": "strapi start",
    "build": "strapi build",
    "strapi": "strapi",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "seed": "node scripts/seed.js",
    "seed:force": "node scripts/seed.js --force"
  },
  "dependencies": {
    "@strapi/plugin-users-permissions": "5.58.0",
    "@strapi/provider-email-nodemailer": "5.58.0",
    "@strapi/strapi": "5.58.0",
    "pg": "^8.23.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.3",
    "styled-components": "^6.1.19"
  },
  "optionalDependencies": {
    "better-sqlite3": "^12.4.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.0.0 <=24.x.x",
    "npm": ">=6.0.0"
  },
  "strapi": {
    "uuid": "atlas-horizons-voyages-cms"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true,
    "@swc/core@1.16.18": true,
    "core-js-pure@3.50.0": true
  }
}
