# ══════════════════════════════════════════════════════════════
#  Configuration de PRODUCTION (Docker Compose) — copier en .env
#  Générer tous les secrets d'un coup :  ./deploy/scripts/generate-secrets.sh
#  (le développement local utilise backend/.env et frontend/.env.local)
# ══════════════════════════════════════════════════════════════

# ─── Domaines (DNS de type A pointant vers l'IP du VPS) ───────
# Site public : https://example-agence.ma  (www.example-agence.ma redirige dessus)
SITE_DOMAIN=example-agence.ma
# Administration Strapi + médias : https://cms.example-agence.ma
CMS_DOMAIN=cms.example-agence.ma
# Email du compte Let's Encrypt (alertes d'expiration)
LETSENCRYPT_EMAIL=admin@example-agence.ma

# ─── PostgreSQL ───────────────────────────────────────────────
POSTGRES_DB=strapi
POSTGRES_USER=strapi
POSTGRES_PASSWORD=changeMe

# ─── Secrets Strapi (valeurs aléatoires, ne jamais réutiliser celles du dev) ─
APP_KEYS=changeMe1,changeMe2,changeMe3,changeMe4
API_TOKEN_SALT=changeMe
ADMIN_JWT_SECRET=changeMe
TRANSFER_TOKEN_SALT=changeMe
JWT_SECRET=changeMe
ENCRYPTION_KEY=changeMe

# Token d'API partagé Strapi ↔ Next.js (côté serveur uniquement, >= 32 caractères)
FRONTEND_API_TOKEN=changeMe
# Secret d'invalidation du cache ISR (Strapi → Next.js)
REVALIDATE_SECRET=changeMe

# ─── Emails (SMTP : Brevo, Mailjet, OVH, Gmail Workspace…) ────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM="Atlas Horizons Voyages <no-reply@example-agence.ma>"
EMAIL_REPLY_TO=contact@example-agence.ma
# Langue des emails de notification envoyés à l'agence (fr, en, es, de, ar)
AGENCY_EMAIL_LOCALE=fr
# Préfixe des références de réservation (ex. AHV-2610-K7M2QX)
RESERVATION_PREFIX=AHV

# ─── Anti-spam Cloudflare Turnstile (https://dash.cloudflare.com → Turnstile) ─
# Laisser vides pour désactiver (pot de miel + limitation de débit restent actifs).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ─── Mesure d'audience Google Analytics 4 (optionnelle, après consentement) ─
GA_ID=

# ─── Stockage des médias : local (volume Docker) | cloudinary | aws-s3 ─
UPLOAD_PROVIDER=local
CLOUDINARY_NAME=
CLOUDINARY_KEY=
CLOUDINARY_SECRET=
S3_ACCESS_KEY_ID=
S3_ACCESS_SECRET=
S3_REGION=
S3_BUCKET=
S3_ENDPOINT=
S3_CDN_URL=
# Domaines d'images supplémentaires autorisés par la CSP de l'admin Strapi (ex. res.cloudinary.com)
CSP_MEDIA_SOURCES=
# Mêmes domaines pour le site Next.js (images optimisées + CSP), séparés par des virgules
EXTRA_IMAGE_HOSTS=

# ─── Sauvegardes ──────────────────────────────────────────────
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14
