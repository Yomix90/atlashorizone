# À coller dans Dokploy → votre application Compose → onglet « Environment ».
# Générez chaque secret avec :  openssl rand -hex 32   (APP_KEYS : 4 valeurs séparées par des virgules)

SITE_DOMAIN=example-agence.ma
CMS_DOMAIN=cms.example-agence.ma

POSTGRES_DB=strapi
POSTGRES_USER=strapi
POSTGRES_PASSWORD=

APP_KEYS=
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
TRANSFER_TOKEN_SALT=
JWT_SECRET=
ENCRYPTION_KEY=
# Token Strapi ↔ Next.js (>= 32 caractères) et secret d'invalidation du cache
FRONTEND_API_TOKEN=
REVALIDATE_SECRET=

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM="Atlas Horizons Voyages <no-reply@example-agence.ma>"
EMAIL_REPLY_TO=contact@example-agence.ma
AGENCY_EMAIL_LOCALE=fr
RESERVATION_PREFIX=AHV

# Cloudflare Turnstile (laisser vide pour désactiver)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Google Analytics 4 (optionnel, chargé après consentement)
GA_ID=

# Construire les images une par une (moins de RAM pendant le build)
COMPOSE_PARALLEL_LIMIT=1

# Médias : local | cloudinary | aws-s3
UPLOAD_PROVIDER=local
CSP_MEDIA_SOURCES=
EXTRA_IMAGE_HOSTS=
